{
  "name": "vigila/cloud-surveillance",
  "type": "project",
  "description": "Sistema de gestión VIGILA para videovigilancia en AWS",
  "keywords": ["laravel", "aws", "videovigilancia"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "aws/aws-sdk-php": "^3.0",
    "laravel/framework": "^13.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"]
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": { "php-http/discovery": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
